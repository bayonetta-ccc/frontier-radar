{
  "slug": "quant_research",
  "name": "量化研究",
  "language": "zh",
  "description": "跟踪因子方法、另类数据、AI 投研工具链与岗位技能变化。",
  "stages": [
    {
      "level": 0,
      "key": "paper",
      "label": "论文/预印本",
      "keywords": ["论文", "预印本", "SSRN", "arXiv", "期刊", "peer-reviewed", "working paper"]
    },
    {
      "level": 1,
      "key": "replication",
      "label": "代码复现",
      "keywords": ["复现", "代码", "notebook", "repository", "开源实现", "replication"]
    },
    {
      "level": 2,
      "key": "backtest",
      "label": "回测验证",
      "keywords": ["回测", "样本外", "walk-forward", "夏普", "回撤", "backtest", "out-of-sample"]
    },
    {
      "level": 3,
      "key": "paper_trade",
      "label": "模拟盘/小资金",
      "keywords": ["模拟盘", "paper trading", "小资金", "实盘测试", "pilot account"]
    },
    {
      "level": 4,
      "key": "production_plan",
      "label": "生产化计划",
      "keywords": ["生产化", "上线计划", "风控上线", "容量评估", "production plan"]
    },
    {
      "level": 5,
      "key": "production",
      "label": "已上线运行",
      "keywords": ["已上线", "实盘运行", "生产环境", "in production", "live trading"]
    }
  ],
  "entities": [
    {"key": "vendor_a", "name": "另类数据供应商 A", "aliases": ["AltData A", "供应商A"], "kind": "vendor"},
    {"key": "broker_b", "name": "券商 B", "aliases": ["Broker B"], "kind": "broker"},
    {"key": "fund_c", "name": "量化私募 C", "aliases": ["Fund C"], "kind": "fund"},
    {"key": "oss_factor", "name": "开源因子库", "aliases": ["factor zoo", "因子库"], "kind": "repository"},
    {"key": "regulation", "name": "交易制度/监管", "aliases": ["程序化交易新规", "交易所规则"], "kind": "regulator"}
  ],
  "anchors": [
    {
      "key": "factor_method",
      "name": "新因子方法的可信度",
      "claim_kind": "technology",
      "keywords": ["因子", "alpha", "信号", "样本外", "容量", "衰减"],
      "entity_keys": ["oss_factor"],
      "question": "近期出现的新因子方法是否经过独立复现与样本外验证？",
      "baseline_claim": "新因子方法仍以论文和回测为主，缺少独立样本外复现",
      "watch_indicators": ["是否出现第三方复现代码", "样本外区间是否覆盖不同市场状态", "容量与交易成本是否披露"],
      "next_verification": "优先核对复现代码与样本外区间，而不是论文里的样本内夏普。"
    },
    {
      "key": "alt_data",
      "name": "另类数据的可用性",
      "claim_kind": "commercialization",
      "keywords": ["另类数据", "卫星", "信用卡", "招聘数据", "数据覆盖", "PIT"],
      "entity_keys": ["vendor_a"],
      "question": "另类数据是否具备可用的历史覆盖与 point-in-time 质量？",
      "baseline_claim": "另类数据供应商的历史覆盖与 PIT 质量仍不透明",
      "watch_indicators": ["是否提供 PIT 快照与回填说明", "覆盖率与存活偏差披露", "独立客户的成本收益证据"],
      "next_verification": "要求供应商提供 PIT 样本与回填日志，并用小样本复核。"
    },
    {
      "key": "ai_tooling",
      "name": "AI 投研工具的生产可用性",
      "claim_kind": "technology",
      "keywords": ["LLM", "Agent", "投研工具", "检索", "幻觉", "评测"],
      "entity_keys": ["fund_c", "broker_b"],
      "question": "AI 投研工具是否达到生产可用，而不是演示可用？",
      "baseline_claim": "AI 投研工具仍停留在演示与辅助检索阶段",
      "watch_indicators": ["是否有可复核的评测集", "错误率与人工复核成本", "是否接入真实交易流程"],
      "next_verification": "找有评测集与错误率披露的案例，而不是产品发布会。"
    },
    {
      "key": "hiring_skill",
      "name": "量化岗位技能变化",
      "claim_kind": "talent",
      "keywords": ["招聘", "JD", "技能", "工程师", "研究员"],
      "entity_keys": ["fund_c", "broker_b"],
      "question": "量化岗位的技能要求是否从传统因子研究转向工程与数据？",
      "baseline_claim": "量化岗位对工程与数据能力的要求正在上升",
      "create_baseline_claim": false,
      "watch_indicators": ["同一岗位 JD 的 6 个月变化", "工程类岗位占比", "面试流程是否增加工程环节"],
      "next_verification": "对比同一公司同一岗位的历史 JD。"
    },
    {
      "key": "regulation",
      "name": "程序化交易监管影响",
      "claim_kind": "standard",
      "keywords": ["程序化交易", "报备", "撤单", "高频", "监管", "新规"],
      "entity_keys": ["regulation"],
      "question": "程序化交易新规是否改变了策略容量与合规成本？",
      "baseline_claim": "程序化交易监管仍处于细则落地阶段，合规成本上升但边界未定",
      "watch_indicators": ["实施细则是否发布", "报备口径与过渡期", "券商是否调整接入要求"],
      "next_verification": "以交易所正式细则为准，区分征求意见稿与实施稿。"
    }
  ],
